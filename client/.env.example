# Local dev: leave EMPTY. Vite proxies /api -> http://localhost:5000
# (see vite.config.js), so there is no CORS and no URL to keep in sync.
#
# Production: the full backend URL, ending in /api, e.g.
#   VITE_API_URL=https://your-backend.vercel.app/api
# Set it in the Vercel dashboard rather than committing it here.
#
# Vite only reads this file at startup — restart `npm run dev` after changing it.
VITE_API_URL="http://localhost:5000/api"
