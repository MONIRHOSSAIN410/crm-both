PORT=5000
NODE_ENV=development

# LOCAL (MongoDB Compass):  mongodb://127.0.0.1:27017/muldhon
# VERCEL  (MongoDB Atlas):  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/muldhon
#
# Vercel cannot reach localhost — deployment REQUIRES an Atlas URI, and
# Atlas -> Network Access must allow 0.0.0.0/0 (Vercel has no fixed IP).
# A password containing @ : / ? or # must be URL-encoded.
MONGO_URI="mongodb+srv://akmmonir304_db_user:RlIk79dxjEwJhDOX@cluster0.gdnwfvf.mongodb.net/muldhon?appName=Cluster0"

# Use a long random string in production. Changing it signs everyone out.
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Only needed when the client is served from a DIFFERENT origin than the API.
# In the single-project Vercel deployment they share an origin, so CORS never
# comes into play and this can stay as-is.
# Comma separated, NO trailing slash (a trailing slash breaks CORS).
CLIENT_URL="https://crm-both-pk2m.vercel.app/api"
